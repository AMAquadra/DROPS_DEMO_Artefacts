    <changeSet id="1.0.0-1-table-expedition" author="amabrouk">
        <comment>Socle : table des expeditions</comment>
        <createTable tableName="EXPEDITION">
            <column name="ID" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="NUM_COLIS"  type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="NOM_CLIENT" type="VARCHAR(80)"><constraints nullable="false"/></column>
            <column name="VILLE"      type="VARCHAR(60)"><constraints nullable="false"/></column>
            <column name="ZONE_CODE"  type="VARCHAR(5)"><constraints nullable="false"/></column>
            <column name="STATUT"     type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="MONTANT"    type="DECIMAL(10,2)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

